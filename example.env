# Copy to .env. Never commit .env.

# Host directory with the runtime state: config, router.db, SSH keys, local git repo.
DATA_DIR=/var/lib/credfeto-oxidized
OXIDIZED_TAG=latest
WATCHTOWER_SCHEDULE=0 52 * * * *

# Host egress firewall (firewall/configure, run by ./update): "true" drops
# traffic the rules do not allow; anything else only logs it (observation mode).
# OXIDIZED_FIREWALL_ENFORCE=true
